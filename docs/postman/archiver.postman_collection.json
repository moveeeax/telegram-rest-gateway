{
  "info": {
    "name": "telegram-rest-gateway — archiver",
    "description": "API архиватора (HTTP :8090). Наружу не выставлен: только kubectl -n tgw port-forward svc/tgw-tools-archiver 8090:8090.\n\nТокены: {{token}} = ARCHIVER_TOKEN (токен MCP, только /search); {{adminToken}} = ARCHIVER_ADMIN_TOKEN (/stats, /backfill, /media/retry, DELETE /accounts). Токен MCP на админских путях получает 403.\n\nsession_id = accountId воркера control plane (a + 10 символов). /search без session_id отдает 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Живость процесса. Без авторизации.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            },
            "description": "Счётчики: messages, chats, processed_events, dropped_events и статус медиа-оффлоада (pending/uploaded/failed).\n\n⚠ Через прод-Ingress не доступен (наружу выставлены только /search и /health) — используй kubectl port-forward и окружение archiver-local.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q={{q}}&session_id={{sessionId}}&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{q}}"
                },
                {
                  "key": "session_id",
                  "value": "{{sessionId}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Полнотекстовый поиск в срезе одного аккаунта. session_id обязателен."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Backfill",
      "item": [
        {
          "name": "Start backfill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"throttle_ms\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/backfill",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "backfill"
              ]
            },
            "description": "Бэкфилл истории аккаунта. Адрес гейтвея и токен архиватор берет из реестра control plane, в теле только session_id. Аккаунт без archive_enabled получает 400.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Backfill status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/backfill",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "backfill"
              ]
            },
            "description": "Текущее состояние бэкфилла (running, chats_done/chats_total, messages_added, error) и статус медиа-оффлоада. Стейт — in-memory: обнуляется при рестарте пода.\n\n⚠ Через прод-Ingress не доступен — используй kubectl port-forward.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Media retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/media/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "retry"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Заново ставит в очередь строки с file_id без media_url (по умолчанию за 7 дней; поле since в epoch-секундах). Без session_id по всем аккаунтам.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\"\n}"
            }
          }
        },
        {
          "name": "Purge account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{sessionId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Удаляет архив аккаунта: сообщения, чаты, seq и медиа media/<sessionId>/ в S3. Control plane вызывает его сам при удалении аккаунта."
          }
        }
      ]
    }
  ]
}
