# Стиль проекта: база Google, отступ 4, ширина 100.
BasedOnStyle: Google
Language: Cpp
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
IncludeBlocks: Regroup
SortIncludes: CaseInsensitive
IncludeCategories:
  - Regex: '^<td/'
    Priority: 3
  - Regex: '^<drogon/|^<trantor/'
    Priority: 3
  - Regex: '^"'
    Priority: 1
  - Regex: '^<'
    Priority: 4
